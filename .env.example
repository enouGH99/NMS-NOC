# ==========================================
# NMS NOC - Environment Variables Configuration
# ==========================================

# 1. Database Connection (PostgreSQL 16 + TimescaleDB)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgres://postgres:Dimas*007@localhost:5432/nms_db"

# PostgreSQL Container Credentials (for Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="Dimas*007"
POSTGRES_DB="nms_db"

# 2. Better Auth & Security
BETTER_AUTH_SECRET="nms-noc-production-super-secret-key-32chars-length-min"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Server Configuration
PORT=3000
NODE_ENV="production"
